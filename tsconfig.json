{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    //"allowImportingTsExtensions": false,
    //"moduleSuffixes": [".js", ".ts"]
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"],
}
